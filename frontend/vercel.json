{
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/src/api/(.*)",
      "status": 403
    },
    {
      "src": "/src/components/(.*)",
      "status": 403
    },
    {
      "src": "/src/pages/(.*)",
      "status": 403
    },
    {
      "src": "/src/middleware/(.*)",
      "status": 403
    },
    {
      "src": "/src/provider/(.*)",
      "status": 403
    },
    {
      "src": "/src/static/(.*)",
      "status": 403
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}